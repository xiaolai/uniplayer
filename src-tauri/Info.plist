<?xml version="1.0" encoding="UTF-8"?>
<!--
  Merged into the bundle's Info.plist by tauri-bundler.

  Since macOS 15 a process that touches the local network needs the user's
  permission, and the system asks for it the first time something multicasts.
  Without a usage description the prompt has nothing to say about *why*, which
  is the worst possible moment to be vague: the answer decides whether the
  player can ever see a television. NSBonjourServices declares the service types
  the player browses, which the platform requires to be listed.
-->
<plist version="1.0">
<dict>
    <!--
      The layered macOS 26+ icon: the name of the app icon inside
      Contents/Resources/Assets.car (tauri.macos.conf.json copies it there). It is
      the `.icon` document's basename — src-tauri/icons/UniPlayer.icon — and the
      `--app-icon` value scripts/build-icons.sh hands actool, so all three are
      renamed together or not at all: a catalogue with no matching name makes
      macOS fall back to the .icns without a word.

      The bundler's own CFBundleIconFile (icon.icns) stays, and is not redundant:
      macOS 26+ prefers the catalogue, everything older ignores this key.
    -->
    <key>CFBundleIconName</key>
    <string>UniPlayer</string>

    <key>NSLocalNetworkUsageDescription</key>
    <string>UniPlayer looks for televisions and media receivers on your network so it can play videos on them.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_googlecast._tcp</string>
    </array>

    <!--
      `uniplayer://join/<code>` — an invitation to a shared viewing.

      Declared here by hand rather than left to the deep-link plugin's own
      build step, which writes `CFBundleURLTypes` only for the *mobile* half of
      its configuration; the desktop half is the bundler's, and this file is
      already the place this project states what it wants merged into the
      bundle's Info.plist. Explicit beats a behaviour that would have to be
      re-verified after every toolchain bump, and the failure it prevents is a
      silent one: an unregistered scheme makes a link do nothing at all.

      Windows needs nothing here — there the scheme is a registry key the
      plugin writes at runtime (`register_all`), which is why that call is
      unconditional on startup.
    -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>live.uniplayer</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>uniplayer</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
